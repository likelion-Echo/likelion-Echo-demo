DATABASE_URL=postgresql+psycopg://echo:echo@localhost:5433/echo
OPENAI_API_KEY=sk-...

# 없으면 서버가 뜨지 않는다. 배포할 때는 반드시 새 값으로 바꿀 것.
JWT_SECRET=change-me-in-production

# 해커톤 시연 관리자. 값이 없으면 admin@gmail.com / admin으로 생성된다.
# 실제 배포에서는 반드시 별도의 강한 값으로 바꾼다.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin
ADMIN_NAME=Echo 관리자

# Gmail SMTP: 발송 전용 Gmail 계정의 주소와 16자리 앱 비밀번호를 Cloud Run 비밀값으로 넣는다.
# SMTP_APP_PASSWORD에는 일반 Gmail 비밀번호를 넣지 않는다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=echo.demo.mail@gmail.com
SMTP_APP_PASSWORD=your-16-digit-google-app-password

# 이메일 속 초대 링크의 프론트엔드 주소. 배포 후 실제 HTTPS 주소로 바꾼다.
FRONTEND_APP_URL=http://localhost:3000

# 프론트엔드 주소. 배포 시 도메인을 콤마로 구분해 추가한다.
CORS_ORIGINS=http://localhost:3000

# 같은 와이파이의 다른 기기(192.168.x.x 등)에서 오는 요청을 자동으로 허용한다.
# 데모용이라 기본 켜져 있다. 인터넷에 배포할 때는 false 로 끈다.
CORS_ALLOW_LAN=true

# 위기 신호 키워드 (SAFE-03). 하나라도 걸리면 LLM을 호출하지 않고 상담 안내를 돌려준다.
# 비교 전에 공백을 모두 지우므로 "죽고 싶다"와 "죽고싶다"가 함께 걸린다.
# 이 서비스는 죽음을 이야기하는 곳이라 "돌아가셨", "죽음" 같은 3인칭 표현은 넣지 않는다.
# 넣으면 정상 대화가 전부 상담 안내로 막힌다.
CRISIS_KEYWORDS=자살,죽고싶,죽고싶다,죽을래,죽을거야,죽어버리,따라죽,같이죽,목숨을끊,목숨끊,스스로목숨,극단적선택,자해,살기싫,살고싶지않,사라지고싶,없어지고싶,뛰어내리,유서

# 위기 신호에 돌려줄 안내 문구. 상담 창구 번호가 바뀌면 여기서 고친다.
# 줄바꿈은 \n 이 아니라 실제 줄바꿈을 쓸 수 없으므로, 바꾸려면 app/main.py의 기본값을 고치는 편이 낫다.
# CRISIS_MESSAGE=

# 관련 기록으로 인정할 최대 코사인 거리 (작을수록 엄격, 0~2).
# 무관한 질문에 엉뚱한 기록이 근거로 붙으면 낮추고, 관련 기록을 자꾸 놓치면 올린다.
MAX_RELEVANT_DISTANCE=0.70

# 음성 파일 저장 위치 (backend 기준 상대경로)
STORAGE_DIR=storage/uploads
