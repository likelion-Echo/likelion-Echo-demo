DATABASE_URL=postgresql+psycopg://echo:echo@localhost:5433/echo
OPENAI_API_KEY=sk-...

# 없으면 서버가 뜨지 않는다. 배포할 때는 반드시 새 값으로 바꿀 것.
JWT_SECRET=change-me-in-production

# 프론트엔드 주소. 배포 시 도메인을 콤마로 구분해 추가한다.
CORS_ORIGINS=http://localhost:3000

# 관련 기록으로 인정할 최대 코사인 거리 (작을수록 엄격, 0~2).
# 무관한 질문에 엉뚱한 기록이 근거로 붙으면 낮추고, 관련 기록을 자꾸 놓치면 올린다.
MAX_RELEVANT_DISTANCE=0.70

# 음성 파일 저장 위치 (backend 기준 상대경로)
STORAGE_DIR=storage/uploads
